{
  "name": "xmart-supershop-api",
  "version": "1.0.0",
  "description": "X-Mart SuperShop API — production-ready e-commerce backend",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "vercel-build": "npm run build",
    "doctor": "tsx src/scripts/doctor.ts",
    "setup": "npm run doctor && npm run seed:admin",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint src --fix",
    "seed": "tsx src/seed/seed.ts",
    "seed:admin": "tsx src/seed/seed.ts --admin",
    "seed:users": "tsx src/seed/seed.ts --users",
    "seed:catalog": "tsx src/seed/seedCatalog.ts",
    "sync:indexes": "tsx src/scripts/syncIndexes.ts",
    "seed:demo": "tsx src/seed/seed.ts && tsx src/seed/seedCatalog.ts && tsx src/seed/seedOrders.ts",
        "migrate:branch-refs": "tsx src/scripts/normalizeBranchRefs.ts",
    "seed:orders": "tsx src/seed/seedOrders.ts",
    "smoke": "tsx src/scripts/smokeTest.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "http-status": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "mongoose": "^8.5.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sslcommerz-lts": "^1.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.21",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.1",
    "eslint": "^9.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  }
}
