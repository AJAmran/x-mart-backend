# ─────────────────────────────────────────────────────────────────────────────
# X-Mart API — environment configuration
#
# Setup:  cp .env.example .env   then fill in the values marked REQUIRED.
# Verify: npm run doctor        (fails loudly and tells you exactly what is wrong)
#
# Every variable the API reads is listed here. Nothing else is read, and no
# secret has an in-code fallback — a missing required value stops the boot
# instead of silently falling back to an insecure default.
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=5000


# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. Local docker compose default:
#   mongodb://appuser:apppassword@localhost:27017/xmart
# Atlas example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xmart?retryWrites=true&w=majority
MONGO_URI=mongodb://appuser:apppassword@localhost:27017/xmart


# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Generate a strong random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each secret.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# bcrypt cost factor. 12 is a good balance; higher is slower and safer.
BCRYPT_SALT_ROUND=12


# ── URLs ─────────────────────────────────────────────────────────────────────
# PUBLIC base URL of this API. Used to build absolute links (reset emails, etc).
# Behind a reverse proxy set the public https address, not the container port.
BACKEND_URL=http://localhost:5000

# PUBLIC base URL of the storefront. This is the single source of truth for the
# CORS allowlist — set it to the customer's real domain or every browser
# request will be rejected with "Not allowed by CORS".
CLIENT_URL=http://localhost:3000


# ── Payments (SSLCommerz) ────────────────────────────────────────────────────
# From your SSLCommerz merchant panel → Store Setup.
# Sandbox credentials and live credentials both work; the sandbox base URL is
# the default so you can test the full checkout without real money.
Store_ID=
Store_Password=

# sandbox = https://sandbox.sslcommerz.com
# live    = https://securepay.sslcommerz.com
SSL_COMMERCE_URL=https://sandbox.sslcommerz.com


# ── Image hosting (Cloudinary) ───────────────────────────────────────────────
# REQUIRED in production. Product and outlet images are uploaded to Cloudinary.
# Leave blank in development to skip image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── Seed admin ───────────────────────────────────────────────────────────────
# Created by `npm run seed:admin` (and automatically on first docker boot).
# CHANGE THE PASSWORD before exposing the site publicly.
ADMIN_EMAIL=admin@xmart.com
ADMIN_PASSWORD=Admin@123
ADMIN_MOBILE_NUMBER=+8801999999999
ADMIN_PROFILE_PHOTO=


# ── Scheduled jobs ───────────────────────────────────────────────────────────
# REQUIRED in production. Guards GET /api/v1/cron/* so nobody else can trigger
# your scheduled jobs. Generate a long random string.
# In docker compose this is called from the host's crontab.
CRON_SECRET=


# ── Optional ─────────────────────────────────────────────────────────────────
# Base URL used by `npm run smoke` to pick which environment to test.
# BASE_API=http://localhost:5000/api/v1
# Credentials the smoke test logs in with (defaults match the seed data).
# USER_EMAIL=rafiq.hasan@example.com
# USER_PASSWORD=User@123